# Meghnaad: the default colours of the web app. Soft basic colours (the page draws them gently, and lighter
# as a background), few rules, no shading of alternate rows. Taskwarrior's own defaults are the "taskwarrior" theme.
rule.precedence.color=deleted,completed,active,keyword.,tag.,project.,overdue,scheduled,due.today,due,blocked,blocking,recurring,tagged,uda.
rule.color.merge=1
color.alternate=
color.active=bold on sage
color.blocked=slate
color.blocking=bold sky
color.completed=
color.deleted=
color.due=amber
color.due.today=bold amber
color.overdue=bold coral
color.project.none=
color.recurring=orchid
color.scheduled=sky
color.tag.next=bold teal
color.tag.none=
color.tagged=
color.until=
color.uda.priority.H=bold coral
color.uda.priority.M=amber
color.uda.priority.L=sage
color.label=
color.label.sort=
color.header=slate
color.footnote=slate
color.warning=bold amber
color.error=bold coral
color.debug=slate
color.calendar.due=on amber
color.calendar.due.today=bold on amber
color.calendar.holiday=on sage
color.calendar.overdue=on coral
color.calendar.scheduled=on sky
color.calendar.today=bold on sky
color.calendar.weekend=on pearl
color.calendar.weeknumber=slate
color.burndown.done=on sage
color.burndown.pending=on coral
color.burndown.started=on amber
color.history.add=on sky
color.history.delete=on coral
color.history.done=on sage
color.summary.background=on pearl
color.summary.bar=on sage
color.sync.added=sage
color.sync.changed=amber
color.sync.rejected=coral
color.undo.after=sage
color.undo.before=coral
