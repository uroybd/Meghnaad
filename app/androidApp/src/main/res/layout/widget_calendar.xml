<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:textColor="@color/widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/previous"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="@string/widget_previous"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_left" />

            <ImageButton
                android:id="@+id/next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="@string/widget_next"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_right" />

            <ImageButton
                android:id="@+id/refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@null"
                android:contentDescription="@string/widget_refresh"
                android:padding="8dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="2dp">

            <TextView android:id="@+id/wd0" style="@style/CalendarWeekday" />
            <TextView android:id="@+id/wd1" style="@style/CalendarWeekday" />
            <TextView android:id="@+id/wd2" style="@style/CalendarWeekday" />
            <TextView android:id="@+id/wd3" style="@style/CalendarWeekday" />
            <TextView android:id="@+id/wd4" style="@style/CalendarWeekday" />
            <TextView android:id="@+id/wd5" style="@style/CalendarWeekday" />
            <TextView android:id="@+id/wd6" style="@style/CalendarWeekday" />
        </LinearLayout>

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:horizontalSpacing="0dp"
            android:listSelector="@null"
            android:numColumns="7"
            android:stretchMode="columnWidth"
            android:verticalSpacing="0dp" />

        <TextView
            android:id="@+id/caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="@color/widget_dim"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
