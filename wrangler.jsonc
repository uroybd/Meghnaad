{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taskwarrior-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "app",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "TASKS",
      "bucket_name": "taskwarrior-sync"
    }
  ],
  "keep_vars": true
}
